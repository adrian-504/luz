package app.iptvplayer.platform.apple

import app.iptvplayer.domain.id.CredentialRef
import app.iptvplayer.domain.security.Secret
import app.iptvplayer.domain.security.SecretBundle
import app.iptvplayer.domain.security.SensitiveUrl
import kotlinx.coroutines.test.runTest
import kotlin.test.AfterTest
import kotlin.test.Test
import kotlin.test.assertEquals
import kotlin.test.assertFalse
import kotlin.test.assertNull
import kotlin.test.assertTrue

/** The Keychain holds a login whole, replaces it, keeps references apart and forgets it (ADR-0015). */
class KeychainSecretStoreTest {
    private val store = KeychainSecretStore(service = "app.iptvplayer.secrets.test")
    private val first = CredentialRef("keychain-test-first")
    private val second = CredentialRef("keychain-test-second")

    @AfterTest
    fun cleanUp() = runTest {
        store.delete(first)
        store.delete(second)
    }

    @Test
    fun aLoginIsStoredWholeAndForgotten() = runTest {
        assertNull(store.get(first))
        assertFalse(store.exists(first))
        store.put(
            first,
            SecretBundle(
                username = Secret("canary-user"),
                password = Secret("CANARY-PW-7f3a9c-DO-NOT-LOG"),
                secretUrl = SensitiveUrl.of("https://guide.example.com/xmltv.php?key=canary"),
                secretHeaders = mapOf("Authorization" to Secret("Bearer canary")),
            ),
        )
        val read = store.get(first)!!
        assertEquals("canary-user", read.username?.unsafeValue())
        assertEquals("CANARY-PW-7f3a9c-DO-NOT-LOG", read.password?.unsafeValue())
        assertEquals("https://guide.example.com/xmltv.php?key=canary", read.secretUrl?.unsafeRawValue())
        assertEquals("Bearer canary", read.secretHeaders["Authorization"]?.unsafeValue())
        assertTrue(store.exists(first))

        store.delete(first)
        assertNull(store.get(first))
    }

    @Test
    fun aNewLoginReplacesTheOldAndReferencesStayApart() = runTest {
        store.put(first, SecretBundle(password = Secret("old")))
        store.put(second, SecretBundle(password = Secret("other")))
        store.put(first, SecretBundle(password = Secret("new")))
        assertEquals("new", store.get(first)?.password?.unsafeValue())
        assertEquals("other", store.get(second)?.password?.unsafeValue())
        assertNull(store.get(first)?.username, "a replaced login keeps nothing of the old one")
    }
}
