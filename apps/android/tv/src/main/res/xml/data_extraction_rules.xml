<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred until the backup policy for user state is designed (SECURITY.md §2: the secret
     blob must always be excluded). Matches android:allowBackup="false" on Android 11 and lower. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
