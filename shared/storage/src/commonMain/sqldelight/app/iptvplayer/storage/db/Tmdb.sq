-- Public lists read from TMDB with the viewer's own key (ADR-0038): trending, popular and top rated films and shows.
-- Not tied to a source: a list is the same whoever's library it is matched against. Each list is replaced whole.
CREATE TABLE tmdb_title (
    list TEXT NOT NULL,
    rank INTEGER NOT NULL,
    tmdb_id INTEGER NOT NULL,
    content_type TEXT NOT NULL,
    title TEXT NOT NULL,
    year INTEGER,
    rating REAL,
    votes INTEGER,
    -- The keys a library row of the same work may carry: "tmdb:<id>"; the cleaned title with its year; and the title alone,
    -- which only a row whose provider gave no year carries.
    tmdb_key TEXT NOT NULL,
    title_key TEXT NOT NULL,
    bare_title_key TEXT NOT NULL,
    fetched_at INTEGER NOT NULL,
    PRIMARY KEY (list, rank)
);

deleteList:
DELETE FROM tmdb_title WHERE list = ?;

insertTitle:
INSERT OR REPLACE INTO tmdb_title(list, rank, tmdb_id, content_type, title, year, rating, votes, tmdb_key, title_key, bare_title_key,
    fetched_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

lastFetched:
SELECT MAX(fetched_at) FROM tmdb_title;

listCounts:
SELECT list, COUNT(*) AS title_count FROM tmdb_title GROUP BY list;

deleteAll:
DELETE FROM tmdb_title;

-- The films of a list the library holds, in the list's order; the version shown is the primary one (ADR-0035). Each list
-- entry looks its keys up in the work index — three equality joins, never a pass over the library — and only the few
-- films found are read whole (CROSS JOIN keeps SQLite from scanning the library for them).
moviesOfList:
WITH hit(id, rank, rating) AS (
    SELECT mo.id, t.rank, t.rating FROM tmdb_title t
    JOIN movie mo ON mo.playlist_id = :playlistId AND mo.snapshot = :snapshot AND mo.work_key = t.tmdb_key
    WHERE t.list = :list
    UNION ALL
    SELECT mo.id, t.rank, t.rating FROM tmdb_title t
    JOIN movie mo ON mo.playlist_id = :playlistId AND mo.snapshot = :snapshot AND mo.work_key = t.title_key
    WHERE t.list = :list
    UNION ALL
    SELECT mo.id, t.rank, t.rating FROM tmdb_title t
    JOIN movie mo ON mo.playlist_id = :playlistId AND mo.snapshot = :snapshot AND mo.work_key = t.bare_title_key
    WHERE t.list = :list
),
best(id, list_rank, tmdb_rating) AS (SELECT id, MIN(rank), MAX(rating) FROM hit GROUP BY id)
SELECT mo.*, w.position_ms, w.duration_ms AS watched_duration_ms, w.completed, (f.content_id IS NOT NULL) AS is_favorite,
    b.list_rank, b.tmdb_rating
FROM best b
CROSS JOIN movie mo ON mo.playlist_id = :playlistId AND mo.snapshot = :snapshot AND mo.id = b.id
LEFT JOIN watch_state w ON w.content_type = 'MOVIE' AND w.content_id = mo.id
LEFT JOIN favorite f ON f.content_type = 'MOVIE' AND f.content_id = mo.id
WHERE (mo.is_primary IS NULL OR mo.is_primary = 1)
    AND mo.id NOT IN (SELECT content_id FROM user_hidden WHERE playlist_id = :playlistId AND content_type = 'MOVIE')
ORDER BY b.list_rank
LIMIT :limit;

seriesOfList:
WITH hit(id, rank, rating) AS (
    SELECT s.id, t.rank, t.rating FROM tmdb_title t
    JOIN series s ON s.playlist_id = :playlistId AND s.snapshot = :snapshot AND s.work_key = t.tmdb_key
    WHERE t.list = :list
    UNION ALL
    SELECT s.id, t.rank, t.rating FROM tmdb_title t
    JOIN series s ON s.playlist_id = :playlistId AND s.snapshot = :snapshot AND s.work_key = t.title_key
    WHERE t.list = :list
    UNION ALL
    SELECT s.id, t.rank, t.rating FROM tmdb_title t
    JOIN series s ON s.playlist_id = :playlistId AND s.snapshot = :snapshot AND s.work_key = t.bare_title_key
    WHERE t.list = :list
),
best(id, list_rank, tmdb_rating) AS (SELECT id, MIN(rank), MAX(rating) FROM hit GROUP BY id)
SELECT s.*, (f.content_id IS NOT NULL) AS is_favorite, b.list_rank, b.tmdb_rating
FROM best b
CROSS JOIN series s ON s.playlist_id = :playlistId AND s.snapshot = :snapshot AND s.id = b.id
LEFT JOIN favorite f ON f.content_type = 'SERIES' AND f.content_id = s.id
WHERE s.id NOT IN (SELECT content_id FROM user_hidden WHERE playlist_id = :playlistId AND content_type = 'SERIES')
ORDER BY b.list_rank
LIMIT :limit;

-- TMDB's rating of one work, from whichever list mentions it.
ratingOf:
SELECT MAX(rating) FROM tmdb_title WHERE content_type = :type AND (tmdb_key = :key OR title_key = :key OR bare_title_key = :key);

-- A title's artwork from TMDB (ADR-0039), keyed by its work so every version and every refresh shares it. A title TMDB
-- does not know is stored with no id, so it is not asked about again until [fetched_at] is old.
CREATE TABLE tmdb_art (
    content_type TEXT NOT NULL,
    work_key TEXT NOT NULL,
    tmdb_id INTEGER,
    logo_path TEXT,
    fetched_at INTEGER NOT NULL,
    PRIMARY KEY (content_type, work_key)
);

-- People as TMDB knows them, keyed by the name as the provider writes it.
CREATE TABLE tmdb_person (
    name TEXT NOT NULL PRIMARY KEY,
    tmdb_id INTEGER,
    profile_path TEXT,
    biography TEXT,
    fetched_at INTEGER NOT NULL
);

artOf:
SELECT * FROM tmdb_art WHERE content_type = ? AND work_key = ?;

saveArt:
INSERT OR REPLACE INTO tmdb_art(content_type, work_key, tmdb_id, logo_path, fetched_at) VALUES (?, ?, ?, ?, ?);

personOf:
SELECT * FROM tmdb_person WHERE name = ?;

-- A portrait learned from a title's credits; a person's own page, read later, replaces it with the biography.
savePortrait:
INSERT OR IGNORE INTO tmdb_person(name, tmdb_id, profile_path, biography, fetched_at) VALUES (?, ?, ?, NULL, ?);

savePerson:
INSERT OR REPLACE INTO tmdb_person(name, tmdb_id, profile_path, biography, fetched_at) VALUES (?, ?, ?, ?, ?);

portraitsOf:
SELECT name, profile_path FROM tmdb_person WHERE name IN ? AND profile_path IS NOT NULL;

deleteArt {
    DELETE FROM tmdb_art;
    DELETE FROM tmdb_person;
}
