-- Guide programmes per EPG source and import snapshot (docs/DOMAIN_MODEL.md §9, docs/EPG.md §4).
-- A snapshot is written completely, then activated in one statement; readers filter on the active snapshot.
CREATE TABLE epg_program (
    row_id INTEGER PRIMARY KEY,
    source_id TEXT NOT NULL,
    snapshot INTEGER NOT NULL,
    id TEXT NOT NULL,
    channel_key TEXT NOT NULL,
    start_utc INTEGER NOT NULL,
    end_utc INTEGER NOT NULL,
    title TEXT NOT NULL,
    subtitle TEXT,
    description TEXT
);

CREATE UNIQUE INDEX epg_program_identity ON epg_program(source_id, snapshot, id);

-- Window queries: equality on source/snapshot/channel, range on start (bounded below by window start - 24 h).
CREATE INDEX epg_program_window ON epg_program(source_id, snapshot, channel_key, start_utc);

CREATE TABLE epg_active_snapshot (
    source_id TEXT PRIMARY KEY NOT NULL,
    snapshot INTEGER NOT NULL
);

-- OR IGNORE: real provider guides repeat the same programme (same channel and start) more than once; the first one wins
-- (found on the owner's provider 2026-09-16, where a duplicate crashed the import).
insertProgram:
INSERT OR IGNORE INTO epg_program(source_id, snapshot, id, channel_key, start_utc, end_utc, title, subtitle, description)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

lastRowId:
SELECT last_insert_rowid();

activate:
INSERT OR REPLACE INTO epg_active_snapshot(source_id, snapshot) VALUES (?, ?);

activeSnapshot:
SELECT snapshot FROM epg_active_snapshot WHERE source_id = ?;

window:
SELECT id, channel_key, start_utc, end_utc, title
FROM epg_program
WHERE source_id = :sourceId
  AND snapshot = :snapshot
  AND channel_key IN :channelKeys
  AND start_utc >= :earliestStart
  AND start_utc < :windowEnd
  AND end_utc > :windowStart
ORDER BY channel_key, start_utc;

deleteSnapshot:
DELETE FROM epg_program WHERE source_id = ? AND snapshot = ?;

countSnapshot:
SELECT count(*) FROM epg_program WHERE source_id = ? AND snapshot = ?;

-- Channel ↔ EPG channel links chosen by EpgMatcher at EPG publish (docs/EPG.md §3). User overrides are stored separately
-- when that feature arrives and are never replaced by imports.
CREATE TABLE channel_epg_link (
    playlist_id TEXT NOT NULL,
    channel_id TEXT NOT NULL,
    epg_source_id TEXT NOT NULL,
    epg_channel_id TEXT NOT NULL,
    method TEXT NOT NULL,
    confidence INTEGER NOT NULL,
    PRIMARY KEY (playlist_id, channel_id)
);

deleteLinks:
DELETE FROM channel_epg_link WHERE playlist_id = ?;

insertLink:
INSERT OR REPLACE INTO channel_epg_link(playlist_id, channel_id, epg_source_id, epg_channel_id, method, confidence) VALUES (?, ?, ?, ?, ?, ?);

linkCount:
SELECT COUNT(*) FROM channel_epg_link WHERE playlist_id = ?;

-- Programmes of linked channels that have not ended before :now and start within the look-ahead, per channel by start.
guideForChannels:
SELECT l.channel_id, p.title, p.start_utc, p.end_utc
FROM channel_epg_link l
JOIN epg_active_snapshot a ON a.source_id = l.epg_source_id
JOIN epg_program p ON p.source_id = l.epg_source_id AND p.snapshot = a.snapshot AND p.channel_key = l.epg_channel_id
WHERE l.playlist_id = :playlistId
  AND l.channel_id IN :channelIds
  AND p.start_utc >= :earliestStart
  AND p.start_utc < :until
  AND p.end_utc > :from
ORDER BY l.channel_id, p.start_utc;
