-- Sport fixtures from football-data.org with the viewer's own token, team names from Wikidata (ADR-0057). Not per
-- source: what the viewer follows is theirs. Must match 16.sqm.

CREATE TABLE sport_follow (
    kind TEXT NOT NULL,
    ref TEXT NOT NULL,
    name TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    PRIMARY KEY (kind, ref)
);

CREATE TABLE sport_team (
    ref TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    short_name TEXT,
    tla TEXT,
    crest_url TEXT,
    fetched_at INTEGER NOT NULL
);

CREATE TABLE sport_alias (
    team_ref TEXT NOT NULL,
    alias_fold TEXT NOT NULL,
    origin TEXT NOT NULL,
    PRIMARY KEY (team_ref, alias_fold)
);

CREATE TABLE sport_fixture (
    id TEXT NOT NULL PRIMARY KEY,
    competition TEXT NOT NULL,
    competition_name TEXT NOT NULL,
    home_ref TEXT NOT NULL,
    away_ref TEXT NOT NULL,
    home_name TEXT NOT NULL,
    away_name TEXT NOT NULL,
    kickoff_utc INTEGER NOT NULL,
    status TEXT NOT NULL,
    fetched_at INTEGER NOT NULL
);

CREATE INDEX sport_fixture_kickoff ON sport_fixture(kickoff_utc);

-- The catalogue (schema 18, 17.sqm): what can be followed.
CREATE TABLE sport_competition (
    code TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    area TEXT,
    emblem_url TEXT,
    fetched_at INTEGER NOT NULL
);

CREATE TABLE sport_team_competition (
    team_ref TEXT NOT NULL,
    competition TEXT NOT NULL,
    PRIMARY KEY (team_ref, competition)
);

CREATE TABLE sport_standing (
    competition TEXT NOT NULL,
    position INTEGER NOT NULL,
    team_ref TEXT NOT NULL,
    team_name TEXT NOT NULL,
    played INTEGER NOT NULL,
    points INTEGER NOT NULL,
    goal_diff INTEGER NOT NULL,
    fetched_at INTEGER NOT NULL,
    PRIMARY KEY (competition, position)
);

CREATE TABLE sport_reminder (
    fixture_id TEXT NOT NULL PRIMARY KEY,
    created_at INTEGER NOT NULL
);

CREATE TABLE sport_fetch (
    resource TEXT NOT NULL PRIMARY KEY,
    fetched_at INTEGER NOT NULL
);

follows:
SELECT kind, ref, name FROM sport_follow ORDER BY created_at;

follow:
INSERT OR REPLACE INTO sport_follow(kind, ref, name, created_at) VALUES (?, ?, ?, ?);

unfollow:
DELETE FROM sport_follow WHERE kind = ? AND ref = ?;

isFollowed:
SELECT COUNT(*) FROM sport_follow WHERE kind = ? AND ref = ?;

saveTeam:
INSERT OR REPLACE INTO sport_team(ref, name, short_name, tla, crest_url, fetched_at) VALUES (?, ?, ?, ?, ?, ?);

team:
SELECT * FROM sport_team WHERE ref = ?;

addAlias:
INSERT OR IGNORE INTO sport_alias(team_ref, alias_fold, origin) VALUES (?, ?, ?);

aliasesOf:
SELECT alias_fold FROM sport_alias WHERE team_ref = ?;

-- Teams one of whose names holds the folded query; the table holds a few names per followed team, so a scan is cheap.
teamsMatching:
SELECT DISTINCT team_ref FROM sport_alias WHERE instr(alias_fold, :query) > 0;

saveFixture:
INSERT OR REPLACE INTO sport_fixture(id, competition, competition_name, home_ref, away_ref, home_name, away_name, kickoff_utc, status, fetched_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

fixture:
SELECT * FROM sport_fixture WHERE id = ?;

fixturesBetween:
SELECT * FROM sport_fixture WHERE kickoff_utc >= :from AND kickoff_utc < :until ORDER BY kickoff_utc, id;

fixturesForTeams:
SELECT * FROM sport_fixture
WHERE kickoff_utc >= :from AND kickoff_utc < :until AND (home_ref IN :teams OR away_ref IN :teams)
ORDER BY kickoff_utc, id;

deleteFixturesBefore:
DELETE FROM sport_fixture WHERE kickoff_utc < ?;

clearStanding:
DELETE FROM sport_standing WHERE competition = ?;

addStanding:
INSERT OR REPLACE INTO sport_standing(competition, position, team_ref, team_name, played, points, goal_diff, fetched_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

standing:
SELECT * FROM sport_standing WHERE competition = ? ORDER BY position;

addReminder:
INSERT OR REPLACE INTO sport_reminder(fixture_id, created_at) VALUES (?, ?);

removeReminder:
DELETE FROM sport_reminder WHERE fixture_id = ?;

-- Reminders for matches not yet past, soonest first.
reminders:
SELECT f.* FROM sport_reminder r JOIN sport_fixture f ON f.id = r.fixture_id WHERE f.kickoff_utc >= ? ORDER BY f.kickoff_utc;

fetchedAt:
SELECT fetched_at FROM sport_fetch WHERE resource = ?;

setFetched:
INSERT OR REPLACE INTO sport_fetch(resource, fetched_at) VALUES (?, ?);

-- Removing the token forgets everything read with it; what the viewer follows stays.
clearFetched:
DELETE FROM sport_fetch;

clearFixtures:
DELETE FROM sport_fixture;

clearStandings:
DELETE FROM sport_standing;

saveCompetition:
INSERT OR REPLACE INTO sport_competition(code, name, area, emblem_url, fetched_at) VALUES (?, ?, ?, ?, ?);

competitions:
SELECT * FROM sport_competition ORDER BY name;

addMembership:
INSERT OR IGNORE INTO sport_team_competition(team_ref, competition) VALUES (?, ?);

competitionsOf:
SELECT c.* FROM sport_team_competition m JOIN sport_competition c ON c.code = m.competition WHERE m.team_ref = ? ORDER BY c.name;

-- Teams in the catalogue, for following: in a competition Luz can read.
catalogueTeams:
SELECT DISTINCT t.* FROM sport_team t JOIN sport_team_competition m ON m.team_ref = t.ref WHERE t.ref IN :refs ORDER BY t.name;

clearCatalogue:
DELETE FROM sport_competition;

clearMemberships:
DELETE FROM sport_team_competition;

clearReminders:
DELETE FROM sport_reminder;
